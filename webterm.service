# Beispiel für den Autostart mit systemd / example systemd unit
#   sudo cp -r . /opt/webterm
#   sudo cp webterm.service /etc/systemd/system/
#   sudo systemctl enable --now webterm
[Unit]
Description=WebTerm - Linux-Terminal im Browser
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Benutzer, dessen Shell im Browser läuft / user whose shell is served
User=root
WorkingDirectory=/opt/webterm
ExecStart=/usr/bin/python3 /opt/webterm/webterm.py --host 127.0.0.1 --port 8022
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
